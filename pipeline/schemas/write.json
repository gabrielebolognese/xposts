{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "hook_index",
  "body",
  "snippets",
  "numbers"
 ],
 "properties": {
  "hook_index": {
   "type": "integer",
   "minimum": 0
  },
  "body": {
   "type": "string",
   "minLength": 400
  },
  "snippets": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "check_id"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "check_id": {
      "type": "string"
     }
    }
   }
  },
  "numbers": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "fact_id"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "fact_id": {
      "type": "string"
     }
    }
   }
  }
 }
}
