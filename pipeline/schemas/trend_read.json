{
 "type": "object",
 "additionalProperties": false,
 "required": ["status", "trends", "candidates"],
 "properties": {
  "status": {"type": "string", "enum": ["ok", "no_browser", "logged_out", "limited"]},
  "note": {"type": "string", "description": "What went wrong, when the status is not ok"},
  "trends": {
   "type": "array",
   "description": "Every trend read on the Trending tab, in order",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "context", "posts"],
    "properties": {
     "name": {"type": "string"},
     "context": {"type": "string", "description": "The category line, like Technology · Trending"},
     "posts": {"type": "string", "description": "The post count as shown, or empty"}
    }
   }
  },
  "candidates": {
   "type": "array",
   "maxItems": 3,
   "description": "The trends that fit the account, best fit first; empty when none fits",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["trend", "context", "posts_count", "why_it_fits", "summary", "posts"],
    "properties": {
     "trend": {"type": "string", "description": "The name exactly as on the tab"},
     "context": {"type": "string"},
     "posts_count": {"type": "string"},
     "why_it_fits": {"type": "string"},
     "summary": {"type": "string", "description": "2 to 4 sentences on what is going on, from the posts"},
     "posts": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": ["id", "author", "time", "likes", "views", "text"],
       "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{1,25}$"},
        "author": {"type": "string"},
        "time": {"type": "string"},
        "likes": {"type": "string"},
        "views": {"type": "string"},
        "text": {"type": "string"}
       }
      }
     }
    }
   }
  }
 }
}
