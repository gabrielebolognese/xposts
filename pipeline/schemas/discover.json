{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": ["candidates"],
 "properties": {
  "candidates": {
   "type": "array",
   "maxItems": 15,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "repo", "official_url", "what_it_does", "problem", "why_now", "pricing_guess", "update_of_known",
                 "update_note", "sources", "triage"],
    "properties": {
     "name": {"type": "string", "minLength": 1},
     "repo": {"type": "string"},
     "official_url": {"type": "string"},
     "what_it_does": {"type": "string"},
     "problem": {"type": "string"},
     "why_now": {"type": "string"},
     "pricing_guess": {"enum": ["free", "freemium", "trial", "paid", "unknown"]},
     "update_of_known": {"type": "boolean"},
     "update_note": {"type": "string"},
     "sources": {"type": "array", "items": {"type": "string"}},
     "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_solving", "savings", "novelty", "relevance", "hook"],
      "properties": {
       "problem_solving": {"type": "integer", "minimum": 0, "maximum": 3},
       "savings": {"type": "integer", "minimum": 0, "maximum": 3},
       "novelty": {"type": "integer", "minimum": 0, "maximum": 3},
       "relevance": {"type": "integer", "minimum": 0, "maximum": 3},
       "hook": {"type": "integer", "minimum": 0, "maximum": 3}
      }
     }
    }
   }
  }
 }
}
