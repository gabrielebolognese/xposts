{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "audience",
  "grabber",
  "body",
  "snippets",
  "numbers",
  "changes"
 ],
 "properties": {
  "audience": {
   "type": "string"
  },
  "grabber": {
   "type": "string"
  },
  "body": {
   "type": "string",
   "minLength": 400
  },
  "snippets": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "check_id"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "check_id": {
      "type": "string"
     }
    }
   }
  },
  "numbers": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "fact_id"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "fact_id": {
      "type": "string"
     }
    }
   }
  },
  "changes": {
   "type": "string"
  }
 }
}
