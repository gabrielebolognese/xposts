{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "paragraphs",
  "issues",
  "notes"
 ],
 "properties": {
  "paragraphs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "issues": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "quote",
     "fix",
     "blocking",
     "earlier"
    ],
    "properties": {
     "kind": {
      "enum": [
       "repeat",
       "deletion",
       "slop",
       "accuracy",
       "privacy",
       "structure"
      ]
     },
     "quote": {
      "type": "string"
     },
     "fix": {
      "type": "string"
     },
     "blocking": {
      "type": "boolean"
     },
     "earlier": {
      "type": "boolean",
      "description": "true when this issue was in the earlier blocking list and is still not solved"
     }
    }
   }
  },
  "notes": {
   "type": "string"
  }
 }
}
