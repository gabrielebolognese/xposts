{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["candidates"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["audience", "problem", "takeaway", "post_type", "niche", "tool", "why_now", "source_ids"],
        "additionalProperties": false,
        "properties": {
          "audience": {"type": "string", "minLength": 3, "maxLength": 90},
          "problem": {"type": "string", "minLength": 20},
          "takeaway": {"type": "string", "minLength": 20},
          "post_type": {"enum": ["tool discovery", "tutorial", "mistake and fix", "comparison", "concept explainer", "industry analysis"]},
          "niche": {"enum": ["ai", "saas", "webdev", "video", "design"]},
          "tool": {"type": "string", "description": "the main tool, product or technology, or 'none'"},
          "why_now": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
